{
    "name": "setup-hemtt-action",
    "version": "0.0.0",
    "private": true,
    "description": "Install HEMTT",
    "main": "lib/main.js",
    "scripts": {
        "build": "tsc",
        "format": "prettier --write \"**/*.ts\"",
        "format-check": "prettier --check \"**/*.ts\"",
        "lint": "eslint --config eslint.config.mjs src/**/*.ts",
        "package": "ncc build src/main.ts -o dist/main && ncc build src/post.ts -o dist/post",
        "all": "npm run build && npm run format && npm run lint && npm run package"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arma-actions/hemtt.git"
    },
    "keywords": [
        "actions",
        "node",
        "setup"
    ],
    "author": "BrettMayson",
    "license": "MIT",
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@terascope/fetch-github-release": "^2.3.1",
        "@typescript-eslint/eslint-plugin": "^8.61.0"
    },
    "devDependencies": {
        "@types/node": "^25.9.2",
        "@typescript-eslint/parser": "^8.61.0",
        "@vercel/ncc": "^0.44.0",
        "eslint": "^9.14.0",
        "eslint-plugin-github": "^6.0.0",
        "js-yaml": "^4.2.0",
        "prettier": "3.8.4",
        "typescript": "^6.0.3"
    }
}